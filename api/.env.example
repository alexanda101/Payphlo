DATABASE_URL="postgresql://app:app@localhost:5432/finapp?schema=public"
PORT=4000
HOST=127.0.0.1

# Required. Generate a long random value for real environments.
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated allowed browser origins for CORS.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional LLM provider.
# Keep "none" for deterministic fallback responses.
# To enable Mistral locally:
#   LLM_PROVIDER=mistral
#   LLM_API_KEY=<your Mistral API key>
#   LLM_MODEL=mistral-small-latest
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=600
LLM_MAX_INPUT_CHARS=8000
LLM_MAX_RESPONSE_CHARS=2500
LLM_TIMEOUT_MS=12000
LLM_TEMPERATURE=0.3
